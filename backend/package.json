{
  "name": "marketplace-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Private-alpha backend for the reseller AI operating system (D-17 baseline, D-18 authorization). One modular monolith; no public surface in this slice.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src test --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run depcruise && npm test",
    "migrate": "node src/db/migrate-cli.ts",
    "web": "node src/web/main.ts"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
